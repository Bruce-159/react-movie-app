VITE_TMDB_API_KEY=your-tmdb-api-key

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# AI 推薦（api/recommend.js）使用，只在伺服器端讀取。
# 不可加 VITE_ 前綴，否則金鑰會被打包進前端、任何人都看得到。
ANTHROPIC_API_KEY=your-anthropic-api-key

# AI 推薦每日次數限制（api/_lib/usage.js）：每個帳號每天 20 次，次數記在 Firestore 的 aiUsage 集合。
# Firebase 主控台 → 專案設定 → 服務帳戶 → 產生新的私密金鑰，把下載的 JSON 轉成 base64（或壓成一行 JSON）貼在這裡。
# 只在伺服器端讀取，不可加 VITE_ 前綴；這把金鑰有整個專案的管理權限，絕對不要 commit。
FIREBASE_SERVICE_ACCOUNT=

# 不受每日次數限制的帳號 Email（需已驗證），多個用逗號分隔。
AI_UNLIMITED_EMAILS=
